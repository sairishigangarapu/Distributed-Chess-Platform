# =================================
# Server Configuration
# =================================
PORT=3000
NODE_ENV=development

# =================================
# Database
# =================================
MONGODB_URI=mongodb://127.0.0.1:27017/chessgame

# =================================
# Authentication
# =================================
# IMPORTANT: Change this to a strong, unique secret in production!
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-key-change-in-production-immediately

# Token expiry (examples: '1h', '24h', '7d', '30d')
JWT_EXPIRES_IN=24h

# =================================
# Client Configuration
# =================================
# URL of the frontend (for CORS)
CLIENT_URL=http://localhost:3000

# =================================
# File Upload
# =================================
# Maximum file size in bytes (default: 5MB)
MAX_FILE_SIZE=5242880

# =================================
# Rate Limiting (optional)
# =================================
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX_REQUESTS=100
